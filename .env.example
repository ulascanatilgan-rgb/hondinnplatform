# REQUIRED on Railway. Choose a long private password shared with your spouse.
APP_PASSWORD=replace-with-a-strong-password
# Persist this directory using a Railway Volume mounted at /data.
DATA_DIR=/data
# Optional. Set a long random string; defaults to HMAC derived from password.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional future PawPass URL:
PAWPASS_URL=
# Optional future walking app URL:
WALK_APP_URL=
# Optional future Arlo dashboard URL (use only official Arlo page):
ARLO_URL=https://my.arlo.com/
